# ==============================================================================
# AI Resume Analyzer & Job Matching Platform Configuration
# Copy this file to '.env' in your root directory and customize values as needed.
# ==============================================================================

# Database Configuration (MySQL / MariaDB in XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=resume_ai

# Google Gemini AI API Configuration (Optional - for LLM-powered resume feedback)
# Free key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Master Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
